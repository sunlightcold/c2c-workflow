{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2C multi-repo project manifest",
  "type": "object",
  "required": ["workspace", "projects"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "workspace": {
      "type": "object",
      "required": ["name", "rootType", "defaultLanguage", "gitStrategy"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "rootType": { "const": "single-repository-workspace" },
        "defaultLanguage": { "type": "string", "minLength": 1 },
        "gitStrategy": { "const": "single-repository" }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "repoType", "domain", "role", "writePolicy", "skills", "packageManager", "commands", "dependsOn"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "repoType": { "const": "workspace-directory" },
          "domain": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "writePolicy": { "const": "development" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "stack": { "type": "array", "items": { "type": "string" } },
          "packageManager": { "type": "string", "minLength": 1 },
          "ports": { "type": "object" },
          "commands": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "contracts": { "type": "object" }
        }
      }
    }
  }
}
