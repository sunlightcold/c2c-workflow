{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2C local skills registry",
  "type": "object",
  "required": ["skillsRoot", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "skillsRoot": { "type": "string", "minLength": 1 },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "entry", "source", "appliesTo"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "entry": { "const": "SKILL.md" },
          "source": {
            "type": "object",
            "required": ["type", "repo", "path", "ref"],
            "properties": {
              "type": { "const": "github" },
              "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
              "path": { "type": "string" },
              "ref": { "type": "string", "minLength": 1 }
            }
          },
          "appliesTo": { "type": "array", "items": { "type": "string" } },
          "usage": { "type": "string" }
        }
      }
    }
  }
}
