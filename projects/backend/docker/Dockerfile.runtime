# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS dependencies

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY backend.package.json ./server/backend/package.json

RUN pnpm install --frozen-lockfile --filter ./server/backend...

RUN pnpm --filter ./server/backend deploy --prod --legacy /runtime \
  && test -d /runtime/node_modules

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends poppler-utils \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    NODE_CONFIG_DIR=/app/config \
    NODE_OPTIONS=--enable-source-maps

WORKDIR /app

COPY --chown=node:node --from=dependencies /runtime/node_modules ./node_modules
COPY --chown=node:node --from=dependencies /runtime/package.json ./package.json

RUN mkdir -p /app/logs /app/dist/apps/static /app/config /app/initJson \
  && chown node:node /app /app/logs /app/dist /app/dist/apps /app/dist/apps/static /app/config /app/initJson

USER node

EXPOSE 3000

CMD ["node", "dist/apps/admin/main.js"]
