{
  "name": "@c2c/backend-workspace",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:server",
    "dev:server": "pnpm --filter ./server/backend run start:dev",
    "dev:mock": "pnpm --filter @c2c/upstream-mock run dev",
    "build": "pnpm run build:libs && pnpm run build:server",
    "build:docker": "pnpm --filter ./libs/build run build",
    "build:server": "pnpm --filter ./server/backend run build",
    "build:libs": "pnpm --filter ./libs/build run build",
    "lint:server": "pnpm --filter ./server/backend run lint",
    "test:server": "pnpm --filter ./server/backend run test",
    "test:mock": "pnpm --filter @c2c/upstream-mock run test",
    "typecheck:mock": "pnpm --filter @c2c/upstream-mock run typecheck",
    "build:mock": "pnpm --filter @c2c/upstream-mock run build",
    "typecheck:server": "pnpm --filter ./server/backend exec tsc --noEmit",
    "catalog": "pnpx codemod run pnpm/catalog --allow-dirty --no-interactive -t .",
    "catalog:check": "node ./scripts/check-catalog.mjs",
    "workspace:check": "node ./scripts/check-workspace.mjs",
    "monorepo:check": "pnpm run workspace:check && pnpm run catalog:check",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {}
}
