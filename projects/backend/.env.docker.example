# C2C 后端镜像。首次部署可用 latest，稳定后应固定为 sha-<40 位提交 SHA>。
C2C_BACKEND_IMAGE=ghcr.io/sunlightcold/c2c-workflow-backend:latest

# Compose 同时将此文件传入 app/migrate，以支持数据库中的 env://SECRET_NAME 引用。
C2C_RUNTIME_ENV_FILE=.env

# OpenResty 反向代理连接的宿主机端口，仅监听 127.0.0.1。
C2C_BACKEND_PORT=3000

# 服务器上的日志与上传文件目录。生产配置已编译进镜像，敏感值仍来自本文件。
C2C_BACKEND_LOG_DIR=./volumes/logs
C2C_BACKEND_STATIC_DIR=./volumes/static

# 对外静态资源地址应填写反向代理后的 HTTPS 地址；末尾不要加斜杠。
C2C_STATIC_SERVER_URL=https://api.example.com
C2C_TIME_ZONE=Asia/Shanghai
C2C_REDIS_PREFIX=c2c
C2C_SUPER_ADMIN_UID=1
C2C_SUPER_ADMIN_NAME=superAdmin

# PostgreSQL 初始化配置，必须与 production.js 中的数据库连接配置一致。
C2C_POSTGRES_HOST=postgres
C2C_POSTGRES_PORT=5432
C2C_POSTGRES_USER=c2c_backend
C2C_POSTGRES_PASSWORD=
C2C_POSTGRES_DB=c2c_backend

# Redis 密码会进入 Redis URL，建议使用 `openssl rand -hex 32` 生成 URL-safe 值。
C2C_REDIS_PASSWORD=

# 首次启动和敏感字段加密需要显式配置，不得提交真实值。
C2C_SUPER_ADMIN_PASSWORD=
C2C_CREDENTIAL_MASTER_KEY=

# 若数据库中使用 env:// 引用 Secret，在此追加对应变量，值通常为 JSON 对象。
# PAYMENT_PROVIDER_PRODUCTION={"clientId":"replace-me","clientSecret":"replace-me"}
